from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

app = FastAPI(title="Dayflow HRMS API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.get("/")
def home():
    return {"message": "Dayflow Backend is running"}

@app.get("/api/employees")
def employees():
    return [
        {"id": 1, "name": "Hasan", "role": "Employee"},
